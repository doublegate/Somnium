{
  "name": "somnium-server",
  "version": "2.0.0",
  "description": "Backend servers for Somnium multiplayer and cloud services",
  "main": "api-server.js",
  "scripts": {
    "start": "node api-server.js",
    "start:multiplayer": "node multiplayer-server.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:multiplayer\"",
    "dev": "concurrently \"nodemon api-server.js\" \"nodemon multiplayer-server.js\"",
    "test": "jest"
  },
  "keywords": [
    "somnium",
    "multiplayer",
    "websocket",
    "game-server"
  ],
  "author": "Somnium Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
